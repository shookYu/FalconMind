# pytest-cov configuration
[run]
source = app
branch = True
omit = 
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */migrations/*
    */alembic/*
    app/main.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    pass
    @abstractmethod
    @abstractproperty

show_missing = True
skip_covered = False
fail_under = 80

[html]
directory = htmlcov

[xml]
output = coverage.xml
