    "@vue-flow/node-resizer": "^1.3.6",
    "axios": "^1.6.7",
    "cesium": "^1.115.0",
    "dayjs": "^1.11.10",
    "element-plus": "^2.5.6",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.7",
    "uuid": "^9.0.1",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "zod": "^3.22.4"
