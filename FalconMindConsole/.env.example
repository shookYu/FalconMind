# FalconMindConsole Environment Configuration
# Copy this file to .env and modify as needed

# ===========================================
# Database Configuration
# ===========================================
DB_USER=falconmind
DB_PASSWORD=falconmind123
DB_NAME=falconmind

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PASSWORD=falconmind123

# ===========================================
# Security
# ===========================================
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# ===========================================
# Auto-initialization Settings
# ===========================================
# Set to 'false' to disable auto-initialization
# AUTO_INIT_DB=true
# AUTO_INIT_DATA=true

# ===========================================
# Ports
# ===========================================
FRONTEND_PORT=80
BACKEND_PORT=9000

# ===========================================
# Development Settings
# ===========================================
# DEBUG=false
# LOG_LEVEL=info
